.tier-card:hover { border-color: var(--border-green); transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4); }
.tier-card.featured { border-color: var(--border-green); }
.tier-head { display: grid; grid-template-columns: 1fr auto; gap: 20px; padding: 24px 30px; border-bottom: 1px solid var(--border); background: var(--bg-tertiary); align-items: center; }
