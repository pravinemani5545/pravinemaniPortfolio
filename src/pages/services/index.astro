.cta-band-inner { max-width: 1440px; margin: 0 auto; padding: 0 clamp(20px, 2.5vw, 48px); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
@media (min-width: 2000px) { .cta-band-inner { max-width: 1760px; } } @media (min-width: 3000px) { .cta-band-inner { max-width: 2200px; } } @media (min-width: 4400px) { .cta-band-inner { max-width: 2800px; } }
.cta-band .left { display: flex; flex-direction: column; gap: 4px; }
.cta-band .lab { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: var(--green); text-transform: uppercase; }
.cta-band .h { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 600; color: var(--text-primary); }
.cta-band .h .acc { color: var(--green); }

/* Featured tier (pilot/sprint/advisory/custom) */
