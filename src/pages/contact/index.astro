---
import Base from '../../layouts/Base.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact · Pravine Mani",
  "description": "Free 30-min scoping call. Written quote within 24 hours.",
  "url": "https://pravinemani.com/contact/",
  "mainEntity": {
    "@type": "Person",
    "name": "Pravine Manivannan",
    "email": "pravinemaniva@gmail.com",
    "url": "https://pravinemani.com/",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "consulting inquiry",
      "email": "pravinemaniva@gmail.com",
      "areaServed": "Worldwide",
      "availableLanguage": "English"
    }
  }
};
---

<Base title="Contact · Book a 30-min Scoping Call · Pravine Mani" description="Book a 30-min scoping call, send a brief, or email. Free. Ends with a written quote within 24 hours. Toronto / remote." jsonLd={jsonLd}>


<section class="page-hero">
  <div class="breadcrumb"><span class="gr">$</span> echo "let's talk" <span class="you">→ 30-min call · email · dm</span></div>
  <h1>Get in touch.<br><span class="accent">Three ways. Pick what fits.</span></h1>
  <p class="lead">Every route below gets you a real answer within 24 hours on weekdays. The 30-min call is the fastest path to a quote. Email works for written-first inquiries. DM is fine for fit-check before booking.</p>
</section>

<section class="section">

  <div class="contact-grid">

    <div class="contact-card featured">
      <div class="label"><span class="dot"></span>FASTEST PATH</div>
      <h3>Book a 30-min scoping call</h3>
      <p>Walk me through the problem in plain English. The call ends with one of three answers: yes here's the fit, no here's who's better at it, or not yet here's what to figure out first. Books within 48 hours.</p>
      <a href="https://cal.com/pravine-manivannan-lpmqgs/30min" target="_blank" rel="noopener" class="btn">Book a 30-min call →</a>
    </div>

    <div class="contact-card">
      <div class="label" style="color: var(--red);">WRITTEN-FIRST</div>
      <h3>Email me</h3>
      <p>If you'd rather write than talk first: describe what's broken. Who you are. When you need it. I read everything personally. Reply within 24 hours on weekdays.</p>
      <a href="mailto:pravinemaniva@gmail.com" class="btn secondary">pravinemaniva@gmail.com →</a>
    </div>

    <div class="contact-card">
      <div class="label" style="color: #a855f7;">CASUAL</div>
      <h3>DM on X or LinkedIn</h3>
      <p>Good for "quick question" or "are you the right person for this." Slower than email, usually 1-2 days. Use for fit-check, not formal scoping.</p>
      <a href="https://x.com/pravinemani" class="btn secondary">@pravinemani on X →</a>
    </div>

    <div class="contact-card">
      <div class="label" style="color: var(--blue);">OPEN-SOURCE</div>
      <h3>Issue / PR on GitHub</h3>
      <p>For questions about <code style="font-family:monospace;color:var(--green);background:var(--bg-tertiary);padding:1px 6px;border:1px solid var(--border);">personalClaudeSkills</code> or other open-source repos. Public discussion, public answer. Faster than DM for tech questions.</p>
      <a href="https://github.com/pravinemani5545" class="btn secondary">@pravinemani5545 →</a>
    </div>

    <div class="contact-card featured" style="grid-column: 1 / -1;">
      <div class="label"><span class="dot"></span>NOT READY FOR A CALL?</div>
      <h3>Send a workflow. Get a written audit in 48 hours. Free.</h3>
      <p>The lowest-friction path. Send a Loom or a written brief of one workflow. I write back with the 3 highest-leverage automations, where to start, what to skip, and rough cost estimates. No sales call attached. Capped at 5 audits per week.</p>
      <a href="/workflow-audit/" class="btn">Send a workflow →</a>
    </div>

  </div>

  <section class="intake-section">
    <div class="intake-head">
      <div class="label">written intake · 4 fields</div>
      <h2>Or send a structured brief.</h2>
      <p>The same info I'd ask on the call. In writing. I read every one. Reply within 24 hours on weekdays. Lands directly in my inbox via FormSubmit.</p>
    </div>

    <form class="intake-form" action="https://formsubmit.co/pravinemaniva@gmail.com" method="POST">
      <input type="hidden" name="_subject" value="New scoping inquiry, pravinemani.com" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="true" />
      <input type="hidden" name="_honey" />
      <input type="hidden" name="_next" value="https://pravinemani.com/contact/?sent=1" />

      <div class="intake-row">
        <label for="name">Your name + company</label>
        <input id="name" type="text" name="name" autocomplete="name" required placeholder="e.g. Jane Doe, Acme Co." />
      </div>

      <div class="intake-row">
        <label for="email">Email to reply to</label>
        <input id="email" type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
      </div>

      <div class="intake-row">
        <label for="broken">What's broken / what do you want shipped?</label>
        <textarea id="broken" name="problem" rows="4" required placeholder="A workflow eating your week. A lead pipeline that doesn't work. SEO ranking authority on a migration. A specific AI agent that should exist."></textarea>
      </div>

      <div class="intake-row intake-row-grid">
        <div>
          <label for="when">When do you need it?</label>
          <select id="when" name="timeline" required>
            <option value="">Pick one…</option>
            <option>This week</option>
            <option>This month</option>
            <option>This quarter</option>
            <option>No rush, exploring</option>
          </select>
        </div>
        <div>
          <label for="budget">Rough budget</label>
          <select id="budget" name="budget" required>
            <option value="">Pick a bracket…</option>
            <option>Under $2K (probably not a fit)</option>
            <option>Mid 4-figures (Audit / Sprint)</option>
            <option>Low 5-figures+ (Custom)</option>
            <option>Not sure yet</option>
          </select>
        </div>
      </div>

      <div class="intake-actions">
        <button type="submit" class="btn intake-submit">Send brief →</button>
        <span class="intake-foot">I read every one personally. No follow-up sequence. No list signup.</span>
      </div>
    </form>
  </section>

  <div class="direct-channels">
    <h4>All channels at a glance</h4>
    <div class="channel"><span class="k">EMAIL</span><span class="v"><a href="mailto:pravinemaniva@gmail.com">pravinemaniva@gmail.com</a></span><span class="speed">~24 HRS</span></div>
    <div class="channel"><span class="k">BOOK CALL</span><span class="v"><a href="https://cal.com/pravine-manivannan-lpmqgs/30min" target="_blank" rel="noopener">cal.com → 30min</a></span><span class="speed">~48 HRS</span></div>
    <div class="channel"><span class="k">X / TWITTER</span><span class="v"><a href="https://x.com/pravinemani">@pravinemani</a></span><span class="speed">~1–2 DAYS</span></div>
    <div class="channel"><span class="k">LINKEDIN</span><span class="v"><a href="https://linkedin.com/in/pravinemani">/in/pravinemani</a></span><span class="speed">~1–2 DAYS</span></div>
    <div class="channel"><span class="k">GITHUB</span><span class="v"><a href="https://github.com/pravinemani5545">@pravinemani5545</a></span><span class="speed">~SAME DAY</span></div>
    <div class="channel"><span class="k">TIMEZONE</span><span class="v">Toronto · ET (UTC-5 / UTC-4)</span><span class="speed">9AM–9PM</span></div>
  </div>

  <div class="scheduling-note">
    <div class="lab">CURRENT AVAILABILITY</div>
    <p><strong>Currently taking new engagements.</strong> Audit and Sprint slots scope within 1-2 weeks. Custom builds quote within a week of inquiry.</p>
  </div>
</section>


</Base>
<style is:global>
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.contact-card { background: var(--bg-card); border: 1px solid var(--border); padding: 28px 30px; position: relative; transition: all var(--dur-base, 200ms) var(--ease); }
.contact-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--card-accent, var(--green)); opacity: 0.85; }
.contact-card:hover { border-color: var(--border-green); transform: translateY(-2px); }
.contact-card.featured { border-color: var(--border-green); }
.contact-card .label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: var(--green); text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
.contact-card .label .dot { width: 6px; height: 6px; background: var(--green); animation: pulse-dot 1.6s infinite; }
.contact-card h3 { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-size: 22px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.01em; margin-bottom: 12px; line-height: 1.25; }
.contact-card p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 18px; }
.contact-card .btn { display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; padding: 12px 20px; background: var(--green); color: var(--bg-primary); transition: all var(--dur-micro, 150ms) var(--ease); }
.contact-card .btn:hover { background: var(--text-primary); }
.contact-card .btn.secondary { background: transparent; color: var(--text-primary); border: 1px solid var(--border); }
.contact-card .btn.secondary:hover { border-color: var(--green); color: var(--green); }
.contact-card:nth-of-type(1) { --card-accent: var(--green); }
.contact-card:nth-of-type(2) { --card-accent: var(--red); }
.contact-card:nth-of-type(3) { --card-accent: #a855f7; }
.contact-card:nth-of-type(4) { --card-accent: var(--blue); }
.direct-channels { background: var(--bg-card); border: 1px solid var(--border); padding: 24px 28px; margin-top: 24px; }
.direct-channels h4 { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: var(--green); text-transform: uppercase; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
.channel { display: grid; grid-template-columns: 100px 1fr auto; gap: 18px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); font-family: 'JetBrains Mono', monospace; }
.channel:last-child { border-bottom: none; }
.channel .k { font-size: 10px; letter-spacing: 0.14em; color: var(--text-dim); text-transform: uppercase; }
.channel .v { font-size: 13px; color: var(--text-primary); }
.channel .v a { color: var(--green); }
.channel .v a:hover { color: var(--text-primary); }
.channel .speed { font-size: 9px; letter-spacing: 0.12em; color: var(--text-dim); text-transform: uppercase; }
.scheduling-note { margin-top: 24px; padding: 20px 24px; background: var(--bg-tertiary); border: 1px solid var(--border); border-left: 2px solid var(--green); }
.scheduling-note .lab { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: var(--green); text-transform: uppercase; margin-bottom: 8px; }
.scheduling-note p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
.scheduling-note p strong { color: var(--text-primary); }
@media (max-width: 720px) { .contact-grid { grid-template-columns: 1fr; } .channel { grid-template-columns: 1fr; gap: 4px; } }

/* ===== Structured intake form ===== */
.intake-section { margin: 36px 0 24px; padding: 28px 30px; background: var(--bg-card); border: 1px solid var(--border); position: relative; }
.intake-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); opacity: 0.85; }
.intake-head { margin-bottom: 22px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
.intake-head .label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: var(--green); text-transform: uppercase; margin-bottom: 8px; }
.intake-head h2 { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-size: clamp(22px, 1.9vw, 30px); font-weight: 600; color: var(--text-primary); letter-spacing: -0.018em; line-height: 1.2; margin-bottom: 8px; }
.intake-head p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 15px; color: var(--text-secondary); line-height: 1.55; max-width: 64ch; }

.intake-form { display: flex; flex-direction: column; gap: 18px; }
.intake-form input[name="_honey"] { display: none !important; }
.intake-row { display: flex; flex-direction: column; gap: 6px; }
.intake-row label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; color: var(--text-dim); text-transform: uppercase; }
.intake-row input, .intake-row textarea, .intake-row select {
  width: 100%;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 15px;
  color: var(--text-primary);
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  padding: 12px 14px;
  outline: none;
  transition: border-color var(--dur-micro, 150ms) var(--ease);
}
.intake-row input:focus, .intake-row textarea:focus, .intake-row select:focus {
  border-color: var(--green);
}
.intake-row input::placeholder, .intake-row textarea::placeholder { color: var(--text-dim); }
.intake-row textarea { resize: vertical; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; line-height: 1.5; }
.intake-row select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--text-dim) 50%), linear-gradient(135deg, var(--text-dim) 50%, transparent 50%); background-position: calc(100% - 18px) 50%, calc(100% - 12px) 50%; background-size: 6px 6px; background-repeat: no-repeat; padding-right: 32px; }
.intake-row-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.intake-row-grid > div { display: flex; flex-direction: column; gap: 6px; }
@media (max-width: 600px) { .intake-row-grid { grid-template-columns: 1fr; } }

.intake-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 6px; }
.intake-submit { display: inline-flex; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 12px 22px; background: var(--green); color: var(--bg-primary); border: none; cursor: pointer; transition: all var(--dur-micro, 150ms) var(--ease); }
.intake-submit:hover { background: var(--text-primary); }
.intake-foot { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: var(--text-dim); }
</style>
<script>
  // Show a confirmation message if the form just submitted (FormSubmit redirects back with ?sent=1)
  if (window.location.search.includes('sent=1')) {
    const section = document.querySelector('.intake-section');
    if (section) {
      const banner = document.createElement('div');
      banner.style.cssText = 'background: var(--bg-tertiary); border: 1px solid var(--green); border-left: 2px solid var(--green); padding: 14px 18px; margin-bottom: 18px; font-family: \'Inter\', sans-serif; font-size: 14px; color: var(--text-primary);';
      banner.textContent = 'Brief received. I read every one personally. Reply within 24 hours on weekdays.';
      section.prepend(banner);
    }
  }
</script>
