---
import Base from '../../layouts/Base.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Writing — Pravine Mani",
  "description": "Essays on AI ops, programmatic SEO + GEO, and the code-first operator stack.",
  "url": "https://pravinemani.com/writing/",
  "author": { "@type": "Person", "name": "Pravine Manivannan", "url": "https://pravinemani.com/" }
};
---

<Base title="Writing — Essays on AI Ops, SEO & Code-First · Pravine Mani" description="Long-form essays on AI workflows, programmatic SEO + GEO, and the code-first operator stack. Drafting now: CPR shared memory layer for Claude Code." jsonLd={jsonLd}>


<section class="page-hero">
  <div class="breadcrumb"><span class="gr">$</span> cat ~/writing/index.md <span class="you">→ essays + build notes</span></div>
  <h1>Writing.<br><span class="accent">Mostly build notes. Occasionally opinions.</span></h1>
  <p class="lead">Short essays on AI automation, solo operator workflows, the tools that actually work and the ones I've stopped using. One piece drafting now — more coming. Subscribe to the AIOpsForge newsletter (Tuesday 9am ET) if you want delivery to your inbox.</p>
</section>

<section class="section">
  <div class="section-head">
    <div class="label">essay index</div>
    <h2>What's live, what's drafting, what's coming.</h2>
    <p>Each piece is short — 600–1,500 words. No fluff. Sentence case. Opinionated.</p>
  </div>

  <div class="essay-list">
    <div class="essay draft">
      <div class="date">2026-05-20</div>
      <div class="info">
        <div class="title">CPR: A Shared Memory Layer for Claude Code and Codex</div>
        <div class="meta">Compress, preserve, resume · persistent context across sessions and agents</div>
      </div>
      <div class="status draft">DRAFTING</div>
    </div>
    <div class="essay draft">
      <div class="date">2026-Q3</div>
      <div class="info">
        <div class="title">Why I don't use n8n, Make, or Zapier — the code-first counter-argument</div>
        <div class="meta">The math behind $0/mo platform vs $300/mo glue · debuggability · vendor lock-in</div>
      </div>
      <div class="status next">QUEUED</div>
    </div>
    <div class="essay draft">
      <div class="date">2026-Q3</div>
      <div class="info">
        <div class="title">Programmatic SEO is dead. Long live programmatic GEO.</div>
        <div class="meta">CTR collapse on Position 1 · passage-citability · llms.txt as the new robots.txt</div>
      </div>
      <div class="status next">QUEUED</div>
    </div>
    <div class="essay draft">
      <div class="date">2026-Q3</div>
      <div class="info">
        <div class="title">What breaks past 5 concurrent agents</div>
        <div class="meta">From the Agentic OS bench · inter-agent state, token cost ceilings, the orchestration patterns that hold</div>
      </div>
      <div class="status next">QUEUED</div>
    </div>
    <div class="essay draft">
      <div class="date">2026-Q4</div>
      <div class="info">
        <div class="title">Productizing the consulting business — one operator, four engagement shapes</div>
        <div class="meta">Capacity caps · fixed-scope · how to refuse work · the economics of scarcity</div>
      </div>
      <div class="status soon">DRAFTING</div>
    </div>
    <div class="essay draft">
      <div class="date">2026-Q4</div>
      <div class="info">
        <div class="title">The 60-line Stripe webhook handler that replaces Zapier</div>
        <div class="meta">Idempotency keys · HMAC verification · the line most builds forget</div>
      </div>
      <div class="status soon">DRAFTING</div>
    </div>
  </div>

  <div class="writing-side reveal" style="margin-top: 24px; padding: 18px 22px; background: var(--bg-tertiary); border: 1px solid var(--border-green); display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: center;">
    <div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: var(--green); text-transform: uppercase; margin-bottom: 4px;">DELIVERY · INBOX</div>
      <div style="font-family: 'IBM Plex Sans', sans-serif; font-size: 15px; color: var(--text-secondary); line-height: 1.5;">Subscribe to the <strong style="color: var(--text-primary);">AIOpsForge newsletter</strong> (Tuesdays 9am ET) — each essay ships to inbox the day it goes live, plus the build notes that didn't make the cut.</div>
    </div>
    <a href="https://aiopsforge.dev" style="font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; color: var(--green); text-transform: uppercase; padding: 9px 14px; border: 1px solid var(--green); white-space: nowrap;">Subscribe →</a>
  </div>
</section>


</Base>
<style is:global>
.essay-list { display: grid; grid-template-columns: 1fr; gap: 0; border: 1px solid var(--border); background: var(--bg-card); }
.essay { display: grid; grid-template-columns: 88px 1fr auto; gap: 20px; align-items: center; padding: 22px 28px; border-bottom: 1px solid var(--border); transition: background var(--dur-micro, 150ms) var(--ease); }
.essay:last-child { border-bottom: none; }
.essay.draft { opacity: 0.6; }
.essay:not(.draft):hover { background: var(--bg-card-hover); border-left: 2px solid var(--green); padding-left: 26px; }
.essay .date { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; color: var(--text-dim); text-transform: uppercase; }
.essay .info .title { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; letter-spacing: -0.01em; line-height: 1.3; }
.essay.draft .info .title { color: var(--text-secondary); }
.essay .info .meta { font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; color: var(--text-secondary); line-height: 1.45; }
.essay .status { font-family: 'JetBrains Mono', monospace; font-size: 9px; padding: 3px 8px; border: 1px solid currentColor; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
.essay .status.live { color: var(--green); }
.essay .status.next { color: #ffd84a; }
.essay .status.draft { color: #a855f7; }
.essay .status.soon { color: var(--text-dim); }
@media (max-width: 720px) { .essay { grid-template-columns: 1fr; gap: 8px; padding: 18px 22px; } .essay:hover { padding-left: 20px; } }
</style>
