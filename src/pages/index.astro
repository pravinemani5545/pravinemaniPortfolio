  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pravine Mani",
  "url": "https://pravinemani.com/",
  "jobTitle": "AI, SEO & Marketing Automation Consultant",
  "description": "Toronto consultancy across AI workflows, programmatic SEO + GEO, and marketing automation. Built like an operator. Sold by the project.",
  "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressCountry": "Canada" },
