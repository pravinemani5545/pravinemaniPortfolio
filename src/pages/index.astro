---
import Base from '../layouts/Base.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pravine Mani",
  "url": "https://pravinemani.com/",
  "jobTitle": "AI, SEO & Marketing Automation Consultant",
  "description": "Toronto consultancy across AI workflows, programmatic SEO + GEO, and marketing automation. Built like an operator. Sold by the project.",
  "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressCountry": "Canada" },
  "sameAs": [
    "https://github.com/pravinemani5545",
    "https://www.linkedin.com/in/pravinemani/",
    "https://aiopsforge.dev"
  ]
};

// ===== Live GitHub commit feed (build-time fetch) =====
// Refreshes on every Vercel deploy. Falls back to a hardcoded list if the
// GitHub API rate-limits or fails. Authenticates if GITHUB_TOKEN env var is set.
interface GHCommit { sha: string; repo: string; type: string; message: string; }
const fallbackCommits: GHCommit[] = [
  { sha: '5f13041', repo: 'portfolio',     type: 'feat',  message: 'right-size desktop headings' },
  { sha: '70f714d', repo: 'portfolio',     type: 'feat',  message: 'de-anonymize CISNET testimonial' },
  { sha: 'f384c87', repo: 'portfolio',     type: 'feat',  message: 'FormSubmit intake + anchor IDs' },
  { sha: '4800cda', repo: 'portfolio',     type: 'feat',  message: 'sprint sub-pages + manifesto' },
  { sha: 'bb08299', repo: 'portfolio',     type: 'feat',  message: 'numbers + pain bands' },
];
const fallbackCadence = '~32 / 30d';
const fallbackTimestamp = '06:42 toronto';

let commits: GHCommit[] = fallbackCommits;
let cadence: string = fallbackCadence;
let commitCount30d: number = 62;
let lastTimestamp: string = fallbackTimestamp;
let lastDate: string = '2026-05-18';

try {
  const headers: Record<string, string> = {
    'Accept': 'application/vnd.github+json',
    'User-Agent': 'pravinemani.com-build',
  };
  const token = import.meta.env.GITHUB_TOKEN;
  if (token) headers.Authorization = `Bearer ${token}`;

  // Step 1, discover repos with activity in the last 30 days via the events API
  // (events PushEvent payloads omit the commits array on this account; that's
  // why we fan out to /repos/<repo>/commits per repo below.)
  const eventsRes = await fetch('https://api.github.com/users/pravinemani5545/events/public?per_page=100', { headers });
  const activeRepos = new Set<string>();
  if (eventsRes.ok) {
    const events = await eventsRes.json() as any[];
    for (const e of events) {
      if (e.type === 'PushEvent' && e.repo?.name) {
        activeRepos.add(e.repo.name);
        if (activeRepos.size >= 6) break;
      }
    }
  }
  // Always include the portfolio repo even if events miss it
  activeRepos.add('pravinemani5545/pravinemaniPortfolio');

  // Step 2, fetch latest commits per repo (parallel)
  const since = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString();
  const allCommits: (GHCommit & { dateMs: number })[] = [];

  await Promise.all([...activeRepos].slice(0, 6).map(async (repo) => {
    try {
      const r = await fetch(
        `https://api.github.com/repos/${repo}/commits?per_page=30&since=${since}&author=pravinemani5545`,
        { headers }
      );
      if (!r.ok) return;
      const data = await r.json() as any[];
      if (!Array.isArray(data)) return;
      const repoShort = repo.split('/').pop()!.slice(0, 16);
      for (const c of data) {
        const fullMsg = ((c.commit?.message) || '').split('\n')[0];
        const colonIdx = fullMsg.indexOf(':');
        const hasType = colonIdx > 0 && colonIdx < 12;
        allCommits.push({
          sha: (c.sha || '').slice(0, 7),
          repo: repoShort,
          type: hasType ? fullMsg.slice(0, colonIdx) : 'commit',
          message: (() => {
            const raw = hasType ? fullMsg.slice(colonIdx + 1).trim() : fullMsg;
            return raw.length > 42 ? raw.slice(0, 40).trimEnd() + '…' : raw;
          })(),
          dateMs: new Date(c.commit?.author?.date || c.commit?.committer?.date || 0).getTime(),
        });
      }
    } catch (_e) { /* ignore single-repo failure */ }
  }));

  if (allCommits.length >= 3) {
    // sort newest first
    allCommits.sort((a, b) => b.dateMs - a.dateMs);

    commits = allCommits.slice(0, 5).map(({ sha, repo, type, message }) => ({ sha, repo, type, message }));
    commitCount30d = allCommits.length;
    cadence = `~${commitCount30d} / 30d`;

    const latestMs = allCommits[0].dateMs;
    if (latestMs) {
      const d = new Date(latestMs);
      const hhmm = d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Toronto' });
      lastTimestamp = `${hhmm} toronto`;
      lastDate = d.toLocaleDateString('en-CA', { timeZone: 'America/Toronto' });
    }
  }
} catch (_err) {
  // silently keep the fallback
}

// `lastDate` already in YYYY-MM-DD via en-CA locale (or fallback ISO format)
