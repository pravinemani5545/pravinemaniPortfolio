---
import Base from '../layouts/Base.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pravine Mani",
  "url": "https://pravinemani.com/",
  "jobTitle": "AI, SEO & Marketing Automation Consultant",
  "description": "Toronto engineer building AI marketing automation: lead-response systems, programmatic SEO + GEO, and AI workflows, owned in code.",
  "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressCountry": "Canada" },
  "sameAs": [
    "https://github.com/pravinemani5545",
    "https://www.linkedin.com/in/pravinemani/",
    "https://aiopsforge.dev"
  ]
};

---

<Base title="Pravine Mani · Marketing Automation, AI & SEO Built in Code · Toronto" description="Toronto engineer building marketing automation and lead-response systems in code: every inbound lead answered in seconds, routed, and owned outright. AI workflow and SEO builds shipped on Vercel." jsonLd={jsonLd}>


<!-- ===== HERO ===== -->
<section class="hero-shell">
  <div class="hero-inner">
  <div class="hero-grid">
    <div class="reveal">
      <div class="prompt-line">
        <span class="gr">$</span>
        <span>whoami</span>
        <span class="you">→ pravine · toronto · ai marketing automation · lead-response · seo + geo</span>
      </div>

      <h1>I build AI marketing automation.<br><span class="accent">So no inbound lead goes cold.</span></h1>

      <p class="lead">I'm a Toronto engineer. I build AI marketing automation: lead-response systems where every inbound lead is answered in seconds, qualified, routed, and logged, with the AI and the orchestration owned outright in code on your stack. SEO and GEO builds round it out. <a href="/why-code-first/">Why code-first →</a></p>

      <div class="cta-row">
        <a href="/contact/" class="cta-btn">Book a 30-min call →</a>
