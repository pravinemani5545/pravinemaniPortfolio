---
import Base from '../../layouts/Base.astro';

// Server-rendered. Runs as a Vercel serverless function so the protected
// content is never sent to the browser until the password is correct.
export const prerender = false;

const PASSWORD = import.meta.env.PRIVATE_PAGE_PASSWORD ?? 'password';

// Logout
if (Astro.url.searchParams.get('logout')) {
  Astro.cookies.delete('pv_gate', { path: '/' });
  return Astro.redirect('/private/', 303);
}

let error = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const attempt = String(form.get('password') ?? '');
  if (attempt === PASSWORD) {
    Astro.cookies.set('pv_gate', PASSWORD, {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: 'lax',
      path: '/',
      maxAge: 60 * 60 * 24 * 30,
    });
    return Astro.redirect('/private/', 303);
  }
  error = true;
}

const authed = Astro.cookies.get('pv_gate')?.value === PASSWORD;
---

<Base title="Private · Pravine Mani" description="Private." noindex={true}>

{!authed && (
  <section class="page-hero gate-wrap">
    <div class="gate">
      <div class="gate-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h1>Private</h1>
      <p>Internal notes. Enter the password to continue.</p>
      <form method="POST" class="gate-form">
        <input type="password" name="password" autocomplete="current-password" placeholder="password" autofocus required />
        <button type="submit">Unlock</button>
      </form>
      {error && <p class="gate-error">Wrong password.</p>}
    </div>
  </section>
)}

{authed && (
  <section class="page-hero">
    <div class="breadcrumb"><span class="gr">$</span> cat ./private/90-day-plan.md</div>
    <h1>90-day agency plan.<br><span class="accent">Jul 10 · Oct 7, 2026.</span></h1>
    <p class="lead">The execution plan for the next quarter, built from the agency research pass on 2026-07-09. This page sits in a public git repo, so it stays semi-public: no prospect names, no outreach scripts, no client financials. Those live in Obsidian.</p>
    <div class="cta-row">
      <a href="/private/?logout=1" class="cta-btn secondary">Lock again</a>
    </div>
  </section>
)}

{authed && (
  <section class="section roadmap">

    <h2>North star</h2>
    <ul class="proof-list">
      <li><strong>Exit day 90 at a $12-20k/mo run rate:</strong> 2-3 active retainers plus 1-2 sprints in flight.</li>
      <li><strong>Positioning:</strong> outcome-first, vertical-anchored. Lead-response and patient/lead acquisition for clinics, local service businesses, and training companies. AI is the delivery mechanism, never the headline. The research is unambiguous: niche agencies close 40% more proposals and charge 2-3x generalist rates, and outcome-metric framing beats tech framing in every 2025-2026 dataset.</li>
      <li><strong>Proof engine:</strong> every delivered engagement produces a numbered case study within 7 days of results landing, and every case study justifies a price test on the next quote.</li>
    </ul>

    <h2>The offer stack (live on /services)</h2>
    <ul class="proof-list">
      <li><strong>Free workflow audit</strong> (48h, async) and the free scoping call: top of funnel, unchanged.</li>
      <li><strong>Pilot Build, $750</strong> credited to Sprint: the paid probe. Push this in outbound; it converts skeptics without a sales cycle.</li>
      <li><strong>Named sprints $2,500-$4,500</strong> (GEO, MCP, pSEO, lead pipeline). Candidate to add once validated in calls: a packaged clinic lead-response build at $7,500 with an appointments-captured guarantee. Validate the guarantee math on 3 real conversations before publishing it.</li>
      <li><strong>Ops Retainer, $1,500/mo keep-it-running or $3,000/mo growth ops.</strong> Never below $1,500: below that the effective hourly is under break-even (64% of agencies price retainers too low; don't join them). Voice-agent hosting margin makes these compound.</li>
      <li><strong>Risk reversal everywhere:</strong> the milestone-refund clause is now public on /services. Say it on every call.</li>
    </ul>

    <h2>Phase 0 · Days 1-14 (Jul 10-23) · Proof + warm network</h2>
    <ul class="proof-list">
      <li>Case studies upgraded with verified GSC and production numbers (shipped 2026-07-09, this deploy).</li>
      <li>Record 2-3 Anna call-audio demos and ship the Voice Agents proof page. Highest-credibility asset that exists and isn't public yet.</li>
      <li>Produce the Orbit and CISNET case studies as 1-page PDFs and 60-90s videos (auto-video pipeline). Three formats per case study is the converting pattern.</li>
      <li>Warm pass: every past client and contact gets a personal note naming the new focus plus one specific introduction ask. Referrals are the #1 agency channel (66-75% of new business). Target: 2-3 warm introductions before day 14.</li>
      <li>Ask Kartik and Mani for full-name, full-title testimonials and Google-visible reviews. The anonymized quotes are the single biggest credibility leak on the site.</li>
      <li>Set up the owned email list on Resend (RESEND_PRAVINEMANI_KEY exists, unused) with a simple monthly build-notes issue. Stop routing the only capture to AIOpsForge.</li>
    </ul>

    <h2>Phase 1 · Days 15-45 (Jul 24-Aug 23) · Outbound engine</h2>
    <ul class="proof-list">
      <li>Build a 1,500-2,500 contact GTA list: dental and specialty clinics, driving schools, home services, training companies. Trigger-qualified only: running ads, hiring front-desk, weak Google Business Profile, slow or no reply to a test inquiry.</li>
      <li><strong>10 personalized video audits per weekday.</strong> Five minutes each: their missed-call test, their lead-response time, one concrete fix. Benchmarks from the research: personalized video pulls 10-16% replies vs 3.4% for text; ~50/week yields roughly 2 booked calls/week.</li>
      <li>Two-call close: 15-25 min discovery with the outcome question, then a one-page proposal with the milestone-refund guarantee and the Pilot as the low-friction yes.</li>
      <li>Target by day 45: first 1-2 sprint closes from cold, plus whatever the warm pass produced.</li>
      <li>Content cadence stays minimal but real: one build-note per week from actual client work (LinkedIn + the new list). No thought-leadership filler.</li>
    </ul>

    <h2>Phase 2 · Days 46-90 (Aug 24-Oct 7) · Partnerships + compounding</h2>
    <ul class="proof-list">
      <li>Pitch 10 Toronto marketing and dental-marketing agencies a white-label build arm: they keep the client, I ship the systems. Partner referrals are the most under-used acquisition channel in every agency survey.</li>
      <li>Book 1-2 local speaking or workshop slots (dental study clubs, small-business meetups). Fastest-rising channel for high-value clients.</li>
      <li>Referral engineering: the ask happens at the case-study moment, when results land, not at contract end. Two asks per delivered engagement.</li>
      <li>Convert every delivered sprint to a retainer at close ("keep it running" is the natural next sentence after handoff).</li>
      <li>Raise the sprint floor after each new case study. New clients pay the new rate first.</li>
      <li>AdBoost attribution data matures this quarter: when the tracker shows booked-call attribution, that becomes case study #3 with dollar figures.</li>
    </ul>

    <h2>Weekly scorecard (fill every Friday)</h2>
    <ul class="proof-list">
      <li>Video audits sent / replies / calls booked / proposals out / closes.</li>
      <li>Pipeline value in writing (proposals outstanding).</li>
      <li>MRR: retainers signed and active.</li>
      <li>Proof shipped: case-study assets, testimonials collected, referral asks made.</li>
      <li>If audits-sent is under 30 for two straight weeks, the plan is failing at the only step that feeds everything else. Fix that before touching anything downstream.</li>
    </ul>

    <h2>Failure modes to refuse</h2>
    <ul class="proof-list">
      <li>Selling "AI" instead of a named outcome. The 2025 MIT/PwC number: 42% of AI pilots produced zero financial impact because they weren't tied to an outcome metric.</li>
      <li>Retainers under $1,500/mo. Custom demos before a signed Pilot. Unpaid scope to keep things pleasant.</li>
      <li>Platform-building before a vertical win. AIOpsForge and product ideas stay parked until the agency run-rate target is hit.</li>
      <li>Tool sprawl: tooling per offer stays under ~$500/yr. The margin is the business.</li>
      <li>New service lanes. The three lanes on the site are the ceiling for this quarter.</li>
    </ul>

    <h2>Site backlog (carry-over)</h2>
    <ul class="proof-list">
      <li>Voice Agents proof page (needs the call audio above), then Prompt+Evals and MCP Servers proof pages.</li>
      <li>Per-page OG images; publish the first essay or cut /writing/ from the nav.</li>
      <li>Live GitHub feed in the hero terminal (GITHUB_TOKEN build-time fetch is already supported, currently hardcoded).</li>
      <li>Pull live GSC and Bing Webmaster exports for the CISNET study refresh (~Jul 20 GSC recheck is already scheduled).</li>
    </ul>

    <div class="proof-note" style="margin-top: 24px;"><strong>Keep out of this page:</strong> prospect names and lists, outreach scripts, client financials, ICP scoring. Those live in Obsidian under Areas/Work/Projects/pravinemani-consulting/. This repo is public.</div>

  </section>
)}

</Base>

<style is:global>
  .gate-wrap { display: flex; align-items: center; justify-content: center; min-height: 70vh; }
  .gate { max-width: 360px; width: 100%; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .gate-icon { color: var(--green); }
  .gate h1 { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.02em; }
  .gate p { font-family: 'IBM Plex Sans', sans-serif; font-size: 15px; color: var(--text-secondary); }
  .gate-form { display: flex; gap: 8px; width: 100%; margin-top: 6px; }
  .gate-form input { flex: 1; height: 44px; padding: 0 14px; background: var(--bg-card); border: 1px solid var(--border); color: var(--text-primary); font-family: 'JetBrains Mono', monospace; font-size: 14px; }
  .gate-form input:focus { outline: none; border-color: var(--green); }
  .gate-form button { height: 44px; padding: 0 18px; background: var(--green); color: var(--bg-primary); border: none; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: background var(--dur-micro, 150ms) var(--ease); }
  .gate-form button:hover { background: var(--text-primary); }
  .gate-error { color: var(--red); font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.04em; }

  .roadmap h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(22px, 2.2vw, 30px); font-weight: 600; color: var(--text-primary); letter-spacing: -0.018em; margin: 36px 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .roadmap h2:first-child { margin-top: 0; }
  .roadmap h3 { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); margin: 22px 0 10px; }
</style>
