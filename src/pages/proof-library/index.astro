---
import Base from '../../layouts/Base.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Proof Library · Pravine Mani",
      "description": "Real sample artifacts from the systems Pravine Mani builds: ad creatives, voice-agent demos, lead-pipeline maps, SEO templates, dashboards, MCP servers, and automation samples, organized by the kind of output a client receives.",
      "url": "https://pravinemani.com/proof-library/",
      "isPartOf": { "@type": "WebSite", "name": "Pravine Mani", "url": "https://pravinemani.com/" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pravinemani.com/" },
        { "@type": "ListItem", "position": 2, "name": "Proof Library", "item": "https://pravinemani.com/proof-library/" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Proof Library samples",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Full Campaign", "url": "https://pravinemani.com/proof-library/full-campaign/" },
        { "@type": "ListItem", "position": 2, "name": "Lead Pipelines", "url": "https://pravinemani.com/proof-library/lead-pipelines/" }
      ]
    }
  ]
};
---

<Base
  title="Proof Library · Sample Outputs · Pravine Mani"
  description="Real artifacts from the systems I build: ad creatives, voice-agent demos, lead-pipeline maps, SEO templates, dashboards, and automation samples, organized by the kind of output a client receives."
  jsonLd={jsonLd}
>

<section class="page-hero">
  <div class="breadcrumb"><span class="gr">$</span> ls ./proof-library</div>
  <h1>Proof Library.<br><span class="accent">Real artifacts from the systems I build.</span></h1>
  <p class="lead">Sample artifacts from the systems I build: ad creatives, voice-agent demos, pipeline maps, SEO templates, dashboards, and automation samples, organized by the kind of output a client receives. Some sections are live now. The rest land as I publish them.</p>
  <div class="cta-row">
    <a href="/proof-library/full-campaign/" class="cta-btn">Start with a full campaign →</a>
    <a href="/work/" class="cta-btn secondary">See shipped case studies</a>
  </div>
</section>

<section class="section">

  <!-- Phase 1 -->
  <div class="proof-phase">
    <div class="proof-phase-head">
      <span class="ph-num">01</span>
      <h2>Conversion proof</h2>
      <span class="ph-note">What a buyer feels first</span>
    </div>
    <div class="proof-grid">

      <a href="/proof-library/full-campaign/" class="proof-card">
        <div class="pc-top"><span class="pc-num">01</span><span class="pc-status live">Live</span></div>
        <h3>Full Campaign</h3>
        <p>One business, one brief, the entire system: ad to SMS to AI voice agent to dashboard to booking. The flagship sample.</p>
        <div class="pc-meta">Funnel map · landing page · ad set · SMS · voice script · dashboard</div>
        <span class="pc-link">View the build →</span>
      </a>

      <a href="/proof-library/lead-pipelines/" class="proof-card">
        <div class="pc-top"><span class="pc-num">02</span><span class="pc-status live">Live</span></div>
        <h3>Lead Pipelines</h3>
        <p>Workflow maps from lead source to human handoff. Triggers, steps, dashboard output, and what happens when a step fails.</p>
        <div class="pc-meta">Source · triggers · steps · handoff · failure states · cost</div>
        <span class="pc-link">View the maps →</span>
      </a>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">03</span><span class="pc-status soon">In progress</span></div>
        <h3>Voice Agents</h3>
        <p>Outbound and inbound AI call agents. Audio demos, transcripts, the structured data each call extracts, and the call flow.</p>
        <div class="pc-meta">Audio · transcripts · structured output · flow diagrams</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">04</span><span class="pc-status soon">In progress</span></div>
        <h3>Ad Creatives</h3>
        <p>Ad sets by industry: the hook, the copy variants, the headlines, and the formats for paid social at volume.</p>
        <div class="pc-meta">Hooks · primary text · headlines · square + story formats</div>
      </div>

    </div>
  </div>

  <!-- Phase 2 -->
  <div class="proof-phase">
    <div class="proof-phase-head">
      <span class="ph-num">02</span>
      <h2>Technical trust</h2>
      <span class="ph-note">For operators evaluating the build</span>
    </div>
    <div class="proof-grid">

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">05</span><span class="pc-status soon">In progress</span></div>
        <h3>Workflow Automation</h3>
        <p>Scheduled and triggered automations. Input, output, the tools connected, and the human approval step.</p>
        <div class="pc-meta">Daily briefs · competitor watch · content engine · inbox triage</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">06</span><span class="pc-status soon">In progress</span></div>
        <h3>Dashboards</h3>
        <p>Lead-ops, content, SEO, and payment dashboards. What each role sees, what they can do, and what stays locked.</p>
        <div class="pc-meta">Tables · filters · actions · audit log · permissions</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">07</span><span class="pc-status soon">In progress</span></div>
        <h3>SEO + GEO</h3>
        <p>The actual assets, not ranking screenshots: page templates, schema markup, GEO content, and a redirect map.</p>
        <div class="pc-meta">pSEO templates · schema JSON-LD · GEO content · redirects</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">08</span><span class="pc-status soon">In progress</span></div>
        <h3>Prompt + Evals</h3>
        <p>Eval suites that keep agents from drifting. Failure modes, test cases, expected behavior, and scoring rubrics.</p>
        <div class="pc-meta">Test cases · expected behavior · scoring · before/after</div>
      </div>

    </div>
  </div>

  <!-- Phase 3 -->
  <div class="proof-phase">
    <div class="proof-phase-head">
      <span class="ph-num">03</span>
      <h2>Deeper credibility</h2>
      <span class="ph-note">Systems integration and craft</span>
    </div>
    <div class="proof-grid">

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">09</span><span class="pc-status soon">In progress</span></div>
        <h3>MCP Servers</h3>
        <p>Custom MCP servers that give Claude real actions on your tools. The tool list, example commands, and the security model.</p>
        <div class="pc-meta">Tool list · example commands · auth model · what stays off</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">10</span><span class="pc-status soon">In progress</span></div>
        <h3>Email Sequences</h3>
        <p>Lifecycle sequences with subject lines, full sample emails, personalization variables, and the automation logic.</p>
        <div class="pc-meta">Email maps · subject lines · personalization · branching</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">11</span><span class="pc-status soon">In progress</span></div>
        <h3>Landing Pages</h3>
        <p>Hero variants and before/after rebuilds across industries, with the conversion sections that carry each page.</p>
        <div class="pc-meta">Hero angles · sections · before/after · mobile layouts</div>
      </div>

      <div class="proof-card soon">
        <div class="pc-top"><span class="pc-num">12</span><span class="pc-status soon">In progress</span></div>
        <h3>UGC Video</h3>
        <p>The strategic output behind paid creative: scripts, hook banks, shot lists, and creator briefs by industry.</p>
        <div class="pc-meta">Scripts · hook banks · shot lists · creator briefs</div>
      </div>

    </div>
  </div>

  <div class="vert-cta reveal" style="margin-top: clamp(40px, 5vw, 72px);">
    <h2>Build one of these for your business</h2>
    <p>Every sample here maps to a fixed-scope engagement. Send the workflow and I'll tell you which one fits.</p>
    <div class="cta-row" style="justify-content: center;">
      <a href="/contact/" class="cta-btn">Discuss a project →</a>
      <a href="/services/" class="cta-btn secondary">See the engagement shapes</a>
    </div>
  </div>

</section>

</Base>
