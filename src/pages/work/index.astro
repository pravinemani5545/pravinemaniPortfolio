---
import Base from '../../layouts/Base.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Work · Pravine Mani",
  "description": "Active builds. Shipped work. AI workflows. SEO + GEO. Marketing automation. Agentic OS. Real artifacts. Public GitHub history.",
  "url": "https://pravinemani.com/work/",
  "hasPart": [
    { "@type": "CreativeWork", "name": "Orbit Dental AI · Patient-acquisition system: site, dashboard, AI voice agent", "url": "https://pravinemani.com/work/case-studies/orbit/" },
    { "@type": "CreativeWork", "name": "Smile Club · Brand-forward marketing site rebuild", "url": "https://pravinemani.com/work/case-studies/smile-club/" },
    { "@type": "CreativeWork", "name": "CISNET · Marketing site + SEO + admin portal", "url": "https://pravinemani.com/work/case-studies/cisnet/" },
    { "@type": "CreativeWork", "name": "AIOpsForge", "url": "https://aiopsforge.dev" },
    { "@type": "CreativeWork", "name": "skills-and-mcp", "url": "https://github.com/pravinemani5545/skills-and-mcp" }
  ]
};
---

<Base title="Work & Case Studies · AI, SEO & Marketing Automation · Pravine Mani" description="Selected work. CISNET case study. AIOpsForge, skills-and-mcp. Plus active builds. Real artifacts. Public GitHub history. Capacity-capped engagements." jsonLd={jsonLd}>


<section class="page-hero">
  <div class="breadcrumb"><span class="gr">$</span> ls -la ~/work <span class="you">→ clients + building + built</span></div>
  <h1>What I'm building<br><span class="accent">and what I've shipped.</span></h1>
  <p class="lead">Three groups. <strong style="color: var(--text-primary);">Client work</strong>: shipped engagements with public case studies. <strong style="color: var(--text-primary);">Building</strong>: active development this week, with commits visible in GitHub. <strong style="color: var(--text-primary);">Built</strong>: shipped and live, or shipped and client-confidential where marked.</p>
</section>

<hr class="divider">

<!-- ===================== CLIENT WORK ===================== -->
<section class="section">
  <div class="group-header reveal">
    <div class="left">
      <div class="lab client"><span class="dot"></span>CLIENT WORK</div>
      <h2>Orbit. Smile Club. CISNET.</h2>
    </div>
    <div class="right">3 PROJECTS · <span class="v" style="color: #dc2626;">CASE STUDIES LIVE</span></div>
  </div>

  <!-- Orbit Dental AI -->
  <div class="client-card orbit reveal">
    <div class="cc-top">
      <div class="cc-logo">
        <div class="mark">OR<span class="acc">BIT</span></div>
        <div class="meta">Toronto · 2026</div>
      </div>
      <div class="cc-body">
        <div class="row1"><span class="status">CLIENT</span><span>3 SYSTEMS · SHIPPED · LIVE</span></div>
        <h3>Patient-acquisition system: site, dashboard, AI voice agent</h3>
        <p>Toronto dental lead-generation and rewards operation. <strong>Three systems shipped end-to-end:</strong> an Astro 6 marketing site with a 6-article SEO and GEO content engine, a Next.js 16 lead-ops dashboard over a 6-stage funnel, and an outbound AI voice agent, "Anna," with the orchestration code-owned on Supabase Edge Functions instead of a no-code wrapper. The flow runs Facebook Lead Ad to instant SMS to scheduled AI call to clinic hand-off to reward.</p>
        <div class="cc-stack">
          <span class="chip">Astro 6</span><span class="chip">Next.js 16</span><span class="chip">React 19</span><span class="chip">Supabase</span><span class="chip">Edge Functions</span><span class="chip">Vapi</span><span class="chip">Claude Haiku</span><span class="chip">Twilio</span><span class="chip">Vercel</span>
        </div>
        <div class="cc-actions">
          <a href="/work/case-studies/orbit/" class="cc-btn">Read case study →</a>
          <a href="/contact/" class="cc-btn ghost">Book a similar project</a>
        </div>
      </div>
    </div>
    <div class="cc-numbers">
      <div class="m"><div class="k">SYSTEMS SHIPPED</div><div class="v"><span class="bl">3</span></div></div>
      <div class="m"><div class="k">SEO ARTICLES</div><div class="v">6</div></div>
      <div class="m"><div class="k">FUNNEL STAGES</div><div class="v"><span class="bl">6</span></div></div>
      <div class="m"><div class="k">ZAPIER FOOTPRINT</div><div class="v">1 ZAP</div></div>
    </div>
  </div>

  <!-- Smile Club -->
  <div class="client-card smile reveal">
    <div class="cc-top">
      <div class="cc-logo">
        <div class="mark">SMILE<span class="acc"> CLUB</span></div>
        <div class="meta">Toronto · 2026</div>
      </div>
      <div class="cc-body">
        <div class="row1"><span class="status">CLIENT</span><span>SHIPPED · LIVE</span></div>
        <h3>Brand-forward marketing site rebuild</h3>
        <p>Toronto dental clinic. <strong>Full Astro 6 marketing-site rebuild</strong> on a new forest-green brand system with prevention-driven positioning. Every line of real copy and photography migrated off the clinic's live site. The build adds an appointment-card hero treatment, a patient-reviews section, an insurance-providers marquee, a branded Open Graph card, and a favicon set, plus an accessibility and performance pass.</p>
        <div class="cc-stack">
          <span class="chip">Astro 6</span><span class="chip">TypeScript</span><span class="chip">Tailwind</span><span class="chip">Vercel</span>
        </div>
        <div class="cc-actions">
          <a href="/work/case-studies/smile-club/" class="cc-btn">Read case study →</a>
          <a href="/contact/" class="cc-btn ghost">Book a similar project</a>
        </div>
      </div>
    </div>
    <div class="cc-numbers">
      <div class="m"><div class="k">BUILD</div><div class="v"><span class="bl">FULL REBUILD</span></div></div>
      <div class="m"><div class="k">BRAND</div><div class="v">NEW SYSTEM</div></div>
      <div class="m"><div class="k">STATUS</div><div class="v"><span class="bl">LIVE</span></div></div>
      <div class="m"><div class="k">STACK</div><div class="v">ASTRO 6</div></div>
    </div>
  </div>

  <div class="client-card reveal">
    <div class="cc-top">
      <div class="cc-logo">
        <div class="mark">CIS<span class="acc">NET</span></div>
        <div class="meta">Toronto · 2025-Q4</div>
      </div>
      <div class="cc-body">
        <div class="row1"><span class="status">CLIENT</span><span>3 MONTHS · SHIPPED · LIVE</span></div>
        <h3>Marketing site + SEO + admin portal rebuild</h3>
        <p>Toronto IT certification training company. <strong>Full migration off legacy PHP onto Next.js 16.</strong> Programmatic SEO across cert × city combinations. A full lead pipeline with a Facebook Lead Ads webhook and Stripe checkout. A <strong>custom admin portal</strong> for leads, enrollments, content, and payments. Shipped Q4 2025, with ranking authority preserved through the redirect strategy.</p>
        <div class="cc-stack">
          <span class="chip">Next.js 16</span><span class="chip">TypeScript</span><span class="chip">Supabase</span><span class="chip">Tailwind</span><span class="chip">Vercel</span><span class="chip">Stripe</span><span class="chip">Resend</span><span class="chip">FB Lead Ads API</span>
        </div>
        <div class="cc-actions">
          <a href="/work/case-studies/cisnet/" class="cc-btn">Read case study →</a>
          <a href="/contact/" class="cc-btn ghost">Book a similar project</a>
        </div>
      </div>
    </div>
    <div class="cc-numbers">
      <div class="m"><div class="k">PSEO PAGES</div><div class="v"><span class="bl">200+</span></div></div>
      <div class="m"><div class="k">LEGACY REDIRECTS</div><div class="v">70+</div></div>
      <div class="m"><div class="k">ADMIN PORTAL</div><div class="v"><span class="bl">FULL</span></div></div>
      <div class="m"><div class="k">DELIVERY</div><div class="v">3 MO</div></div>
    </div>
  </div>
</section>

<hr class="divider">

<!-- ===================== BUILDING ===================== -->
<section class="section">
  <div class="group-header reveal">
    <div class="left">
      <div class="lab live"><span class="dot"></span>CURRENTLY BUILDING</div>
      <h2>Active this week.</h2>
    </div>
    <div class="right">2 PROJECTS</div>
  </div>

  <div class="section-status reveal">
    <span class="pulse"></span>
    <span class="txt"><span class="gr">Live shipping cadence:</span> AIOpsForge leads at 32 commits/mo, bet-tracker 16. <span class="dim">All visible on GitHub.</span></span>
  </div>

  <!-- AIOpsForge -->
  <div class="work-card reveal">
    <div class="wc-top">
      <div class="wc-visual">
        <div class="scrim"></div>
        <div class="frame">
          <div class="chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <span>~/aiopsforge/live</span>
            <span class="lab">● LIVE</span>
          </div>
          <div class="body">
            <div><span class="gr">$</span> tail -f community.log</div>
            <div class="row"><span class="dot gr"></span><span class="dim">2s</span><span>@pravinemani shipped <span class="gr">"v22"</span></span></div>
            <div class="row"><span class="dot yl"></span><span class="dim">14s</span><span>build: claude code + mcp</span></div>
            <div class="row"><span class="dot gr"></span><span class="dim">1m</span><span>@founding_03 forked</span></div>
            <div class="row"><span class="dot dim"></span><span class="dim">3m</span><span>47 systems shipped</span></div>
            <div><span class="gr">$</span><span class="cursor"></span></div>
          </div>
        </div>
      </div>
      <div class="wc-content">
        <div class="row1"><span class="status shipping">PRE-LAUNCH</span><span>2026 · ACTIVE · WAITLIST</span></div>
        <h3>AIOpsForge</h3>
        <p><strong>The bet:</strong> a $9.99/month community for solo AI builders. Pre-launch. The site, Whop integration, gated 14-area workspace, Beehiiv form, Plausible analytics, and SEO and GEO infrastructure are all built. Curriculum in progress. Launching with founding members soon.</p>
        <div class="stack">
          <span class="chip">Vanilla HTML/CSS</span><span class="chip">Vercel</span><span class="chip">Whop</span><span class="chip">Beehiiv</span><span class="chip">Anthropic API</span><span class="chip">Terminal DS</span>
        </div>
        <div class="links">
          <a href="https://aiopsforge.dev">→ Live site</a>
          <span class="sep">·</span>
          <a href="https://github.com/pravinemani5545/aiopsforge-landing">GitHub</a>
          <span class="sep">·</span>
          <a href="https://whop.com/ai-ops-forge/" class="dim">Whop checkout</a>
        </div>
      </div>
    </div>
    <div class="wc-metrics">
      <div class="m"><div class="k">STATUS</div><div class="v"><span class="gr">WAITLIST OPEN</span></div></div>
      <div class="m"><div class="k">STACK</div><div class="v">Next.js · Whop · Supabase</div></div>
    </div>
  </div>

  <!-- betterSpeaking card hidden 2026-05-27: closed alpha, not ready to surface publicly yet.
       Restore the <div class="work-card acc-blue reveal">...</div> block from git history when ready. -->

  <!-- agentic-os -->
  <div class="work-card acc-darkblue reveal">
    <div class="wc-top">
      <div class="wc-visual">
        <div class="scrim"></div>
        <div class="frame">
          <div class="chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <span>agentic-os/research</span>
            <span class="lab" style="color: #1e40af;">R&amp;D</span>
          </div>
          <div class="body">
            <div><span style="color: #1e40af;">// orchestrator</span></div>
            <div><span class="bl">spawn</span> agent.research</div>
            <div><span class="bl">spawn</span> agent.synth</div>
            <div><span class="bl">spawn</span> agent.review</div>
            <div class="dim">→ trade-offs at N=5+</div>
            <div class="dim">→ memory bus latency</div>
            <div><span class="gr">$</span><span class="cursor"></span></div>
          </div>
        </div>
      </div>
      <div class="wc-content">
        <div class="row1"><span class="status research">EXPLORATORY</span><span>2026 · BENCH</span></div>
        <h3>agentic-os</h3>
        <p>A benching project answering one question: <strong>what breaks past 5 concurrent agents?</strong> How to handle inter-agent state. When to use sub-agents over separate processes. Where token cost crosses the line. Not a product. The output is internal write-ups that feed client work and AOF curriculum.</p>
        <div class="stack">
          <span class="chip">Claude API</span><span class="chip">TypeScript</span><span class="chip">MCP</span><span class="chip">Sub-agents</span>
        </div>
        <div class="links">
          <span class="dim">→ Research only</span>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="divider">

<!-- ===================== BUILT ===================== -->
<section class="section">
  <div class="group-header reveal">
    <div class="left">
      <div class="lab shipped"><span class="dot"></span>SHIPPED + LIVE</div>
      <h2>Already in the world.</h2>
    </div>
    <div class="right">3 PROJECTS · <span class="v">SINCE 2023</span></div>
  </div>

  <!-- skills-and-mcp -->
  <div class="work-card reveal">
    <div class="wc-top">
      <div class="wc-visual">
        <div class="scrim"></div>
        <div class="frame">
          <div class="chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <span>~/.claude/skills</span>
            <span class="lab">3 LIVE</span>
          </div>
          <div class="body">
            <div class="row"><span class="dot gr"></span><span class="gr">/growth-sprint</span></div>
            <div class="row"><span class="dot gr"></span><span class="gr">/design-system</span></div>
            <div class="row"><span class="dot gr"></span><span class="gr">/artifact</span></div>
            <div class="row"><span class="dot dim"></span><span class="dim">/preserve (eliaalberti)</span></div>
            <div class="row"><span class="dot dim"></span><span class="dim">/compress (eliaalberti)</span></div>
            <div><span class="gr">$</span> curl install <span class="cursor"></span></div>
          </div>
        </div>
      </div>
      <div class="wc-content">
        <div class="row1"><span class="status live">LIVE</span><span>2026-05 · OPEN-SOURCE</span></div>
        <h3>skills-and-mcp</h3>
        <p><strong>Public Claude Code skill library</strong> on GitHub. Slash commands installed via curl into <code style="font-family:monospace;color:var(--green);background:var(--bg-tertiary);padding:1px 6px;border:1px solid var(--border);">~/.claude/skills/</code>. Skills shipped: <code style="font-family:monospace;color:var(--green);">/growth-sprint</code>, <code style="font-family:monospace;color:var(--green);">/design-system</code>, <code style="font-family:monospace;color:var(--green);">/artifact</code>. Plus EliaAlberti's <code style="font-family:monospace;color:var(--green);">compress/preserve/resume</code> bundle.</p>
        <div class="stack">
          <span class="chip">Claude Code</span><span class="chip">Markdown</span><span class="chip">YAML</span><span class="chip">Open Source</span>
        </div>
        <div class="links">
          <a href="https://github.com/pravinemani5545/skills-and-mcp">→ GitHub repo</a>
          <span class="sep">·</span>
          <a href="https://github.com/pravinemani5545/skills-and-mcp#install">Install command</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Portfolio (this site) -->
  <div class="work-card acc-purple reveal">
    <div class="wc-top">
      <div class="wc-visual">
        <div class="scrim"></div>
        <div class="frame">
          <div class="chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <span>~/portfolio</span>
            <span class="lab" style="color: #a855f7;">META</span>
          </div>
          <div class="body">
            <div class="row"><span class="dot gr"></span><span>/portfolio</span></div>
            <div class="row"><span class="dot gr"></span><span>/services</span></div>
            <div class="row"><span class="dot gr"></span><span>/work</span></div>
            <div class="row"><span class="dot gr"></span><span>/stack</span></div>
            <div class="row"><span class="dot gr"></span><span>/now /about /contact</span></div>
            <div><span class="dim">8 pages · 7 nav links</span></div>
          </div>
        </div>
      </div>
      <div class="wc-content">
        <div class="row1"><span class="status live">LIVE</span><span>2026-05 · THIS SITE</span></div>
        <h3>Portfolio: pravinemani.com</h3>
        <p><strong>This site you're reading right now.</strong> Built in two days on the same Terminal Design System that powers AIOpsForge. 19 pages, scroll-reveal animations, Plausible analytics, and Person JSON-LD. Live at pravinemani.com.</p>
        <div class="stack">
          <span class="chip">Vanilla HTML/CSS</span><span class="chip">Vercel</span><span class="chip">Terminal DS</span><span class="chip">Plausible</span>
        </div>
        <div class="links">
          <a href="/">→ You're here</a>
          <span class="sep">·</span>
          <a href="https://github.com/pravinemani5545/aiopsforge-landing">View on GitHub</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Earlier work, consolidated archive (2023–2024) -->
  <div class="work-card acc-blue reveal">
    <div class="wc-top">
      <div class="wc-visual">
        <div class="scrim"></div>
        <div class="frame">
          <div class="chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <span>~/earlier-work</span>
            <span class="lab" style="color: var(--blue);">2023–2024</span>
          </div>
          <div class="body">
            <div class="row"><span class="dot gr"></span><span>Threads clone</span><span class="dim">RSC + Clerk · 6.4k views</span></div>
            <div class="row"><span class="dot gr"></span><span>PriceScraper</span><span class="dim">Puppeteer · ran 9 months</span></div>
            <div class="row"><span class="dot gr"></span><span>Prompty</span><span class="dim">prompt-sharing · OAuth + feed</span></div>
            <div class="row"><span class="dot gr"></span><span>CarHub</span><span class="dim">RapidAPI · rental browser</span></div>
            <div class="row"><span class="dot gr"></span><span>Gericht</span><span class="dim">React · landing study</span></div>
            <div><span class="dim">// portfolio years</span></div>
          </div>
        </div>
      </div>
      <div class="wc-content">
        <div class="row1"><span class="status shipped">SHIPPED · ARCHIVED</span><span>2023–2024 · PORTFOLIO YEARS</span></div>
        <h3>Earlier work: Threads clone, PriceScraper, Prompty, CarHub, Gericht.</h3>
        <p>The "build something every weekend to learn patterns" era. <strong>Threads clone:</strong> a weekend build for React server components and Clerk auth, 6.4k public views. <strong>PriceScraper:</strong> an Amazon price tracker with Puppeteer that ran on autopilot for 9 months. <strong>Prompty:</strong> a prompt-sharing platform with OAuth, voting, and a discovery feed, built before ChatGPT plugins existed. <strong>CarHub:</strong> a vehicle rental browser on RapidAPI. <strong>Gericht:</strong> a fine-dining landing-page layout study. All shipped, none live anymore. This is the practice behind everything that followed.</p>
        <div class="stack">
          <span class="chip">Next.js</span><span class="chip">React</span><span class="chip">TypeScript</span><span class="chip">MongoDB</span><span class="chip">Clerk</span><span class="chip">Puppeteer</span><span class="chip">OAuth</span><span class="chip">RapidAPI</span><span class="chip">Tailwind</span>
        </div>
        <div class="links">
          <span class="dim">→ Archived</span>
          <span class="sep">·</span>
          <span class="dim">Code / walkthrough available on request</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== CTA ===================== -->
<section class="section">
  <div style="text-align: center; padding: 24px 0;" class="reveal">
    <p style="font-family: 'IBM Plex Sans', sans-serif; font-size: 16px; color: var(--text-secondary); margin: 0;">More on engagements at <a href="/services/" style="color: var(--green); border-bottom: 1px dashed var(--green);">/services</a> · or the <a href="/contact/" style="color: var(--green); border-bottom: 1px dashed var(--green);">contact page →</a></p>
  </div>
</section>




</Base>
<style is:global>
.reveal { opacity: 0; transform: translateY(16px); transition: all 600ms cubic-bezier(0.2, 0, 0, 1); }
.reveal.visible { opacity: 1; transform: translateY(0); }

/* Group header. BUILDING vs BUILT */
.group-header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 14px; margin-bottom: 28px; padding-bottom: 18px; border-bottom: 2px solid var(--border); }
.group-header .left { display: flex; flex-direction: column; gap: 6px; }
.group-header .left .lab { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
.group-header .left .lab .dot { width: 8px; height: 8px; }
.group-header .left .lab.live { color: var(--green); }
.group-header .left .lab.live .dot { background: var(--green); animation: pulse-dot 1.6s infinite; }
.group-header .left .lab.shipped { color: var(--text-secondary); }
.group-header .left .lab.shipped .dot { background: var(--text-secondary); }
.group-header .left h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(26px, 3.2vw, 34px); font-weight: 600; color: var(--text-primary); letter-spacing: -0.02em; line-height: 1.15; }
.group-header .right { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; color: var(--text-dim); text-transform: uppercase; }
.group-header .right .v { color: var(--green); }
.group-header .left .lab.client { color: #dc2626; }
.group-header .left .lab.client .dot { background: #dc2626; }

/* Client work card, uses CISNET brand red */
.client-card { background: var(--bg-card); border: 1px solid var(--border); position: relative; margin-bottom: 24px; transition: all 400ms cubic-bezier(0.2, 0, 0, 1); overflow: hidden; }
.client-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: #dc2626; opacity: 0.85; }
.client-card:hover { border-color: #dc2626; transform: translateY(-3px); box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4); }
.cc-top { display: grid; grid-template-columns: 220px 1fr; gap: 0; align-items: stretch; }
@media (max-width: 720px) { .cc-top { grid-template-columns: 1fr; } }
.cc-logo { background: var(--bg-tertiary); border-right: 1px solid var(--border); padding: 28px 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 160px; }
@media (max-width: 720px) { .cc-logo { border-right: none; border-bottom: 1px solid var(--border); min-height: 110px; } }
.cc-logo .mark { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.02em; }
.cc-logo .mark .acc { color: #dc2626; }
.cc-logo .meta { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: var(--text-dim); text-transform: uppercase; text-align: center; }
.cc-body { padding: 26px 30px; display: flex; flex-direction: column; gap: 14px; }
.cc-body .row1 { display: flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: var(--text-dim); text-transform: uppercase; flex-wrap: wrap; }
