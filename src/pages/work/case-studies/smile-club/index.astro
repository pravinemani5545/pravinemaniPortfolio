const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Smile Club · Brand-forward marketing site rebuild",
      "description": "Full Astro 6 marketing-site rebuild for a Toronto dental clinic. New forest-green brand system, full real-copy and photography migration, prevention-driven positioning, plus an accessibility and performance pass.",
      "datePublished": "2026-04-01",
      "dateModified": "2026-06-21",
      "image": "https://pravinemani.com/og-default.png",
      "author": {
        "@type": "Person",
        "name": "Pravine Manivannan",
        "url": "https://pravinemani.com/"
      },
      "publisher": {
        "@type": "Person",
        "name": "Pravine Manivannan",
        "url": "https://pravinemani.com/"
      },
      "mainEntityOfPage": "https://pravinemani.com/work/case-studies/smile-club/",
      "about": ["Marketing Site", "Brand System", "Astro", "Accessibility"]
    },
    {
      "@type": "Service",
      "name": "Brand-forward marketing site rebuild",
      "serviceType": "Custom Build",
      "provider": { "@type": "Person", "name": "Pravine Manivannan", "url": "https://pravinemani.com/" },
      "areaServed": "Toronto, Canada"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pravinemani.com/" },
        { "@type": "ListItem", "position": 2, "name": "Work", "item": "https://pravinemani.com/work/" },
        { "@type": "ListItem", "position": 3, "name": "Case Studies", "item": "https://pravinemani.com/work/case-studies/" },
        { "@type": "ListItem", "position": 4, "name": "Smile Club", "item": "https://pravinemani.com/work/case-studies/smile-club/" }
      ]
    }
  ]
};
---

<Base title="Smile Club · Case Study · Pravine Mani" description="Brand-forward Astro 6 marketing-site rebuild for a Toronto dental clinic. New forest-green brand system, full copy and photography migration, prevention-driven positioning, plus an accessibility and performance pass." footerVariant="case-study" jsonLd={jsonLd}>


<section class="page-hero">
  <div class="breadcrumb">
    <a href="/work/" style="color: var(--text-dim);">work</a>
    <span style="color: var(--text-muted, #444);">/</span>
    <a href="/work/" style="color: var(--text-dim);">case studies</a>
    <span style="color: var(--text-muted, #444);">/</span>
    <span class="you">smile-club</span>
  </div>
  <h1>Smile Club: a dental clinic site.<br><span class="accent" style="color: #128149; -webkit-text-fill-color: #128149;">Brand-forward marketing rebuild.</span></h1>
  <p class="lead">Full Astro 6 marketing-site rebuild for a Toronto dental clinic. A new forest-green brand system, prevention-driven positioning, and a full migration of real copy and photography off the clinic's live site. Shipped with an accessibility and performance pass.</p>

  <div class="cs-hero-meta">
    <div class="cell"><div class="k">CLIENT</div><div class="v">Dental Clinic · Toronto</div></div>
    <div class="cell"><div class="k">SCOPE</div><div class="v"><span class="bl">Full Marketing Site Rebuild</span></div></div>
    <div class="cell"><div class="k">DELIVERED</div><div class="v">2026 · LIVE</div></div>
    <div class="cell"><div class="k">ROLE</div><div class="v">Solo · End-to-end</div></div>
  </div>
</section>

<section class="section">

  <!-- Problem -->
  <div class="cs-section reveal">
    <div class="lab-col"><span class="num">01 / 04</span><span>THE PROBLEM</span></div>
    <div class="body-col">
      <h2>A clinic site that undersold the practice.</h2>
      <p>The existing marketing site read like a directory listing, not a clinic patients choose on purpose. The positioning was generic and the brand was thin. The copy and photography existed but had no system holding them together. <strong>Prevention is the practice's whole philosophy, and the site never said so.</strong></p>
      <p>The brief was a full rebuild: a brand-forward site that leads with prevention, keeps every piece of real copy and photography, and ships fast and accessible.</p>
      <ul>
        <li><strong>Weak positioning:</strong> generic clinic messaging, no prevention story</li>
        <li><strong>Thin brand:</strong> no cohesive color system or identity</li>
        <li><strong>Unstructured assets:</strong> real copy and photos with no system</li>
        <li><strong>Conversion gap:</strong> no clear path from visit to appointment</li>
      </ul>
    </div>
  </div>

  <!-- What I built -->
  <div class="cs-section reveal">
    <div class="lab-col"><span class="num">02 / 04</span><span>WHAT I BUILT</span></div>
    <div class="body-col">
      <h2>A forest-green brand on Astro 6.</h2>
      <p>A new brand system on a forest-green <code>#128149</code> scale, built around prevention-driven messaging. Every line of real copy and every photograph migrated from the clinic's live site into the new system. The hero uses an appointment-card treatment that puts booking front and center. A patient-reviews section carries the social proof, and an insurance-providers marquee answers the first question most patients ask.</p>
      <p>The polish layer adds a branded, non-person Open Graph link-preview card, a favicon set, and a full accessibility and performance pass. Static Astro 6, deployed on Vercel.</p>
      <ul>
        <li><strong>Brand system:</strong> forest-green <code>#128149</code> scale, prevention-driven messaging</li>
        <li><strong>Migration:</strong> full real-copy and photography migration from the live site</li>
        <li><strong>Hero:</strong> appointment-card treatment leading with booking</li>
        <li><strong>Social proof:</strong> patient-reviews section, insurance-providers marquee</li>
        <li><strong>Polish:</strong> branded non-person OG card, favicon set, accessibility and performance pass</li>
      </ul>
    </div>
  </div>

  <!-- Stack -->
  <div class="cs-section reveal">
    <div class="lab-col"><span class="num">03 / 04</span><span>THE STACK</span></div>
    <div class="body-col">
      <h2>Static, fast, accessible.</h2>
      <p>A marketing site doesn't need a runtime. Astro 6 ships static HTML, the brand system lives in the build, and Vercel serves it. No CMS tax, no client-side weight the page doesn't need.</p>
      <div class="stack-flat">
        <span class="chip daily">Astro 6</span>
        <span class="chip daily">TypeScript</span>
        <span class="chip">Tailwind</span>
        <span class="chip">Vercel</span>
      </div>
    </div>
  </div>

  <!-- Outcome -->
  <div class="cs-section reveal">
    <div class="lab-col"><span class="num">04 / 04</span><span>THE OUTCOME</span></div>
    <div class="body-col">
      <h2>What shipped.</h2>
      <p>Scope facts from the engagement, technical surface only. Business KPIs are the client's to disclose.</p>
      <div class="impact-grid">
        <div class="impact-card"><div class="k">BUILD</div><div class="v">FULL REBUILD</div><div class="desc">Complete Astro 6 marketing site, ground-up from the existing assets.</div></div>
        <div class="impact-card"><div class="k">BRAND</div><div class="v">NEW SYSTEM</div><div class="desc">Forest-green scale on a prevention-driven positioning.</div></div>
        <div class="impact-card"><div class="k">STATUS</div><div class="v">LIVE</div><div class="desc">Shipped and live on Vercel after an accessibility and performance pass.</div></div>
        <div class="impact-card"><div class="k">STACK</div><div class="v">ASTRO 6</div><div class="desc">Static site, TypeScript, Tailwind. No runtime, no CMS tax.</div></div>
      </div>
      <p style="margin-top: 20px;">Beyond the numbers: the site now reads like a clinic patients choose on purpose. The prevention story leads, and the booking path is clear from the hero down.</p>

      <div class="confidential">
        <strong>Note:</strong> Traffic, booking, and conversion numbers are the client's to disclose and aren't shown here.
      </div>

      <p style="margin-top: 24px;"><a href="https://smile-club.vercel.app" style="color: var(--green); border-bottom: 1px dashed var(--green);">View the live site →</a></p>
    </div>
  </div>

  <!-- Final CTA -->
  <div class="final-cta reveal" style="text-align: center;">
    <p style="margin: 0;">Similar surface area: a clinic or service site to rebuild, a brand to sharpen, real assets to carry over. <a href="/contact/" style="color: var(--green); border-bottom: 1px dashed var(--green);">Discuss the project →</a></p>
  </div>

</section>




</Base>
<style is:global>
.reveal { opacity: 0; transform: translateY(16px); transition: all 600ms cubic-bezier(0.2, 0, 0, 1); }
.reveal.visible { opacity: 1; transform: translateY(0); }

.cs-hero-meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 32px; }
.cs-hero-meta .cell { background: var(--bg-card); padding: 16px 20px; }
.cs-hero-meta .cell .k { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: var(--text-dim); text-transform: uppercase; margin-bottom: 5px; }
.cs-hero-meta .cell .v { font-family: 'Space Grotesk', sans-serif; font-size: clamp(15px, 1.15vw, 19px); font-weight: 600; color: var(--text-primary); letter-spacing: -0.01em; }
.cs-hero-meta .cell .v .bl { color: #128149; }
.cs-hero-meta .cell .v .gr { color: var(--green); }
@media (max-width: 720px) { .cs-hero-meta { grid-template-columns: repeat(2, 1fr); } }

.cs-section { display: grid; grid-template-columns: 240px 1fr; gap: 48px; padding: 56px 0; border-bottom: 1px solid var(--border); }
.cs-section:last-of-type { border-bottom: none; }
.cs-section .lab-col { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: #128149; text-transform: uppercase; display: flex; flex-direction: column; gap: 6px; }
.cs-section .lab-col .num { color: var(--text-dim); font-size: 10px; }
.cs-section .body-col { display: flex; flex-direction: column; gap: 16px; max-width: 70ch; }
.cs-section .body-col h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(24px, 2.4vw, 36px); font-weight: 600; color: var(--text-primary); letter-spacing: -0.02em; line-height: 1.15; }
.cs-section .body-col p { font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(15px, 1.1vw, 18px); color: var(--text-secondary); line-height: 1.7; }
.cs-section .body-col p strong { color: var(--text-primary); }
.cs-section .body-col p code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; color: var(--green); background: var(--bg-tertiary); padding: 1px 6px; border: 1px solid var(--border); }
.cs-section .body-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
.cs-section .body-col ul li { padding-left: 20px; position: relative; font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(14.5px, 1.05vw, 17px); color: var(--text-secondary); line-height: 1.6; }
.cs-section .body-col ul li::before { content: '+'; position: absolute; left: 0; color: #128149; font-family: 'JetBrains Mono', monospace; font-weight: 600; }
.cs-section .body-col ul li strong { color: var(--text-primary); }
@media (max-width: 900px) { .cs-section { grid-template-columns: 1fr; gap: 16px; padding: 40px 0; } .cs-section .lab-col { flex-direction: row; align-items: center; gap: 12px; } }

.impact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 8px; }
.impact-card { background: var(--bg-card); border: 1px solid var(--border); padding: 22px 24px; position: relative; }
.impact-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: #128149; opacity: 0.85; }
.impact-card .k { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; color: #128149; text-transform: uppercase; margin-bottom: 10px; }
.impact-card .v { font-family: 'Space Grotesk', sans-serif; font-size: clamp(20px, 2vw, 30px); font-weight: 700; color: var(--text-primary); line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 6px; }
.impact-card .desc { font-family: 'IBM Plex Sans', sans-serif; font-size: 13.5px; color: var(--text-secondary); line-height: 1.5; }
@media (max-width: 900px) { .impact-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .impact-grid { grid-template-columns: 1fr; } }

.stack-flat { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
.stack-flat .chip { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 12px; background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-secondary); }
.stack-flat .chip.daily { border-color: #128149; color: #128149; }

.final-cta { background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-tertiary) 100%); border: 1px solid #128149; padding: 48px 40px; margin-top: 48px; text-align: center; position: relative; overflow: hidden; }
.final-cta::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(18, 129, 73, 0.08) 0%, transparent 60%); pointer-events: none; }
.final-cta > * { position: relative; z-index: 1; }
.final-cta h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(24px, 2.6vw, 36px); font-weight: 600; color: var(--text-primary); letter-spacing: -0.02em; margin-bottom: 14px; line-height: 1.15; }
.final-cta h2 .acc { color: #128149; }
.final-cta p { font-family: 'IBM Plex Sans', sans-serif; font-size: 17px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 24px; max-width: 580px; margin-left: auto; margin-right: auto; }

.confidential { padding: 16px 20px; background: var(--bg-tertiary); border: 1px solid var(--border); border-left: 2px solid var(--text-dim); margin-top: 28px; font-family: 'IBM Plex Sans', sans-serif; font-size: 13.5px; color: var(--text-dim); line-height: 1.55; }
.confidential strong { color: var(--text-secondary); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; display: inline-block; margin-right: 6px; }
</style>
