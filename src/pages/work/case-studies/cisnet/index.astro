.timeline-rail .step:last-child { border-bottom: none; }
.timeline-rail .step .when { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; color: #dc2626; text-transform: uppercase; font-weight: 600; }
