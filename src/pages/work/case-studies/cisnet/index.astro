.cs-section:last-of-type { border-bottom: none; }
.cs-section .lab-col { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.16em; color: #dc2626; text-transform: uppercase; display: flex; flex-direction: column; gap: 6px; }
.cs-section .lab-col .num { color: var(--text-dim); font-size: 10px; }
