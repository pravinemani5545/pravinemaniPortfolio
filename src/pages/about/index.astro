const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://pravinemani.com/#person",
      "name": "Pravine Manivannan",
      "url": "https://pravinemani.com/",
      "image": "https://pravinemani.com/og-default.png",
      "jobTitle": "AI, SEO & Marketing Automation Consultant",
      "description": "Toronto solo operator across AI workflows, programmatic SEO + GEO, and marketing automation.",
      "alumniOf": { "@type": "CollegeOrUniversity", "name": "McMaster University" },
      "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressCountry": "Canada" },
      "sameAs": [
        "https://github.com/pravinemani5545",
        "https://www.linkedin.com/in/pravinemani/",
        "https://x.com/pravinemani",
        "https://aiopsforge.dev"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pravinemani.com/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://pravinemani.com/about/" }
      ]
    }
  ]
};
---

<Base title="About — Pravine Mani · Toronto AI, SEO & Marketing Automation Consultant" description="Toronto solo operator across AI workflows, programmatic SEO + GEO, and marketing automation. Built like an operator. McMaster Comp Eng '25." jsonLd={jsonLd}>


<section class="page-hero">
  <div class="breadcrumb"><span class="gr">$</span> cat ~/about.md <span class="you">→ pravine mani · short version</span></div>
  <h1>Solo operator. AI · SEO · marketing automation.<br><span class="accent">Toronto, Canada.</span></h1>
  <p class="lead">Short version: I help solo founders + small teams ship AI, SEO, and marketing automation that compounds. Productized, fixed-scope engagements. No retainer creep. Building AIOpsForge on the side as a $9.99/month community.</p>

  <div class="about-portrait" aria-hidden="true">
    <div class="portrait-frame">
      <div class="portrait-monogram">PM</div>
      <div class="portrait-chrome">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="tag">~/identity</span>
        <span class="live">● LIVE</span>
      </div>
      <div class="portrait-meta">
        <span>PRAVINE MANIVANNAN</span>
        <span class="gr">TORONTO · 2025-PRESENT</span>
      </div>
    </div>
  </div>
</section>

<section class="section">

  <div class="bio-grid">

    <div class="bio-main">
      <h2>The long version.</h2>
      <p>I started shipping web apps in 2022 — Threads clones, price-scrapers, fine-dining landing pages, the usual indie portfolio. Picked up Next.js, TypeScript, Supabase the way most builders did during the post-ChatGPT scramble: by building something every weekend until the patterns stuck.</p>
      <p><strong>The pivot point was Claude Code dropping in 2024.</strong> Suddenly "automate this in a weekend" was actually true for me, and the gap between "I have an idea" and "this is running in production" collapsed from weeks to days. I went deep — sub-agents, MCP, hooks, headless mode — and started getting paid to do for other founders what I was already doing for myself.</p>
      <p>Now I do two things. First: <strong>freelance AI automation</strong> for solo founders + small teams who need workflows shipped fast. <a href="/services/">Four productized engagements</a> — audit, sprint, advisory, custom build — fixed scope, fixed price. Second: <strong>AIOpsForge</strong>, a $9.99/month community teaching other operators to do this themselves. Build guides, prompts, skills, workflows, mentoring.</p>
      <p>I'm not trying to scale into an agency. The whole point is that one operator with the right stack can deliver what teams of 3-5 used to. Solo means I keep ownership of the work, charge fixed prices, and ship without committee.</p>

      <h2>How I work.</h2>
      <p><strong>Async-first.</strong> Slack/email + recorded Looms. Live calls when they actually need to be live — kickoff, milestone demo, post-launch retro. Otherwise async wins on quality and respect for both calendars.</p>
      <p><strong>Written-first.</strong> Every engagement starts with a written spec I send before signing. Every milestone ends with a Loom + written summary. I'd rather over-document than re-explain.</p>
      <p><strong>Opinionated stack.</strong> Claude Code + Vercel + a few well-chosen SaaS. <a href="/stack/">Full stack here.</a> If you're committed to a different stack and it makes sense for what you need built, I'll work in it. If you have no preference, I'll use mine.</p>
      <p><strong>Code-first automation.</strong> No n8n. No Make.com. No Zapier. Workflows are Vercel serverless functions + cron — versioned in git, $0 platform fee, debuggable when something breaks at 3am.</p>

      <h3>What I'm not.</h3>
      <p>Not a designer (though I have strong opinions). Not a data scientist. Not interested in chatbot-for-customer-service work. Not building anything in the AGI/AI-safety space. Not available for full-time positions — solo by choice.</p>
    </div>

    <div class="bio-side">
      <div class="fact-card">
        <div class="label">QUICK FACTS</div>
        <div class="item"><span class="k">BASED</span><span class="v">Toronto, Canada</span></div>
        <div class="item"><span class="k">SHIPPING</span><span class="v">Since 2022</span></div>
        <div class="item"><span class="k">SOLO</span><span class="v"><span class="acc">By choice</span></span></div>
        <div class="item"><span class="k">STATUS</span><span class="v"><span class="acc">Open Q3</span> · 2 slots</span></div>
      </div>

      <div class="fact-card">
        <div class="label">STACK</div>
        <div class="item"><span class="k">DEV</span><span class="v">Claude Code, Vercel</span></div>
        <div class="item"><span class="k">AI</span><span class="v">Claude 4.7, MCP</span></div>
        <div class="item"><span class="k">DATA</span><span class="v">Vercel KV, Supabase</span></div>
        <div class="item"><span class="k">DEPLOY</span><span class="v">Vercel cron + serverless</span></div>
        <div class="item"><span class="k">ANALYTICS</span><span class="v">Plausible</span></div>
      </div>

      <div class="fact-card">
        <div class="label">OUTSIDE WORK</div>
        <div class="item"><span class="k">CITY</span><span class="v">Toronto · year-round</span></div>
        <div class="item"><span class="k">RUNNING</span><span class="v">5k thrice / week</span></div>
        <div class="item"><span class="k">READING</span><span class="v">~2 books / month</span></div>
        <div class="item"><span class="k">NEVER</span><span class="v">Crypto trader, again</span></div>
      </div>
    </div>

  </div>

  <div class="timeline">
    <div class="yr"><span class="year">2026</span><span class="what"><strong>AIOpsForge launched</strong> · $9.99/mo community on Whop · 9 founding spots remaining. Active freelance roster.</span></div>
    <div class="yr"><span class="year">2025</span><span class="what">Pivoted fully to AI automation work. <strong>CISNET marketing site + SEO infrastructure</strong> (200+ pages, Next.js 16, Vercel). First $5k MRR freelance month.</span></div>
    <div class="yr"><span class="year">2024</span><span class="what">Claude Code released. Went deep — sub-agents, MCP, hooks, headless mode. Built first commercial AI workflows for indie founders.</span></div>
    <div class="yr"><span class="year">2023</span><span class="what">Solo dev portfolio years. Threads clone, PriceScraper, Prompty, CarHub, Gericht — building one a weekend to learn patterns.</span></div>
    <div class="yr"><span class="year">2022</span><span class="what">Started shipping web apps in earnest. First Next.js + TypeScript + Supabase project. The "I can actually build this" year.</span></div>
  </div>

</section>


</Base>
<style is:global>
.bio-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; }
.bio-main { display: flex; flex-direction: column; gap: 18px; }
.bio-main h3 { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.01em; margin-top: 16px; }
.bio-main h3:first-child { margin-top: 0; }
.bio-main p { font-family: 'IBM Plex Sans', sans-serif; font-size: 16px; color: var(--text-secondary); line-height: 1.7; max-width: 680px; }
.bio-main p strong { color: var(--text-primary); }
.bio-main p a { color: var(--green); border-bottom: 1px dashed var(--green); }
.bio-side { display: flex; flex-direction: column; gap: 16px; }
.fact-card { background: var(--bg-card); border: 1px solid var(--border); padding: 22px 24px; position: relative; }
.fact-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--card-accent, var(--green)); opacity: 0.8; }
.fact-card .label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.16em; color: var(--green); text-transform: uppercase; margin-bottom: 10px; }
.fact-card .item { display: grid; grid-template-columns: 100px 1fr; gap: 14px; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
.fact-card .item:last-child { border-bottom: none; }
.fact-card .item .k { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-dim); letter-spacing: 0.1em; text-transform: uppercase; }
.fact-card .item .v { color: var(--text-primary); }
.fact-card .item .v .acc { color: var(--green); }
.fact-card:nth-of-type(1) { --card-accent: var(--green); }
.fact-card:nth-of-type(2) { --card-accent: var(--red); }
.fact-card:nth-of-type(3) { --card-accent: #a855f7; }
.timeline { background: var(--bg-card); border: 1px solid var(--border); padding: 24px 28px; margin-top: 24px; }
.timeline .yr { display: grid; grid-template-columns: 80px 1fr; gap: 18px; padding: 12px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
.timeline .yr:last-child { border-bottom: none; }
.timeline .yr .year { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--green); font-weight: 500; }
.timeline .yr .what { font-family: 'IBM Plex Sans', sans-serif; font-size: 15px; color: var(--text-secondary); line-height: 1.5; }
.timeline .yr .what strong { color: var(--text-primary); }
@media (max-width: 980px) { .bio-grid { grid-template-columns: 1fr; } }
</style>
