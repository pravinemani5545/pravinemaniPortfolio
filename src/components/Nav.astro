---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/') return path === '/';
  return path === normalized || path.startsWith(normalized + '/');
};
---
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">~/pravine<span class="cursor"></span></a>
    <div class="nav-links">
      <a href="/services/" class:list={[isActive('/services') && 'active']}>Services</a>
      <a href="/work/" class:list={[isActive('/work') && 'active']}>Work</a>
      <a href="/ai/" class:list={[isActive('/ai') && 'active']}>AI</a>
      <a href="/writing/" class:list={[isActive('/writing') && 'active']}>Writing</a>
      <a href="/stack/" class:list={[isActive('/stack') && 'active']}>Stack</a>
      <a href="/now/" class:list={[isActive('/now') && 'active']}>Now</a>
      <a href="/about/" class:list={[isActive('/about') && 'active']}>About</a>
      <a href="/contact/" class:list={['nav-cta', isActive('/contact') && 'active']}>Book a call →</a>
    </div>
  </div>
</nav>
